@model Grupo2OfertaAcademica.Models.Facultad

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Facultad</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Decano)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Decano)
        </dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("Coordinador"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a>
        <span> | </span>
    }

    <a asp-action="Index">Volver a la lista</a>
</div>
